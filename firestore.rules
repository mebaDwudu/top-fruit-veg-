rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 256;
    }

    // --- Products Collection ---
    match /products/{productId} {
      allow read, write: if isValidId(productId);
    }

    // --- Categories Collection ---
    match /categories/{categoryId} {
      allow read, write: if isValidId(categoryId);
    }

    // --- POS Orders Collection ---
    match /orders/{orderId} {
      allow read, write: if isValidId(orderId);
    }

    // --- Customer Online Orders Collection (Real-Time Customer -> Admin Sync) ---
    match /customer_orders/{orderId} {
      allow read, write: if isValidId(orderId);
    }

    // --- Customer Feedbacks & Reviews Collection ---
    match /feedbacks/{feedbackId} {
      allow read, write: if isValidId(feedbackId);
    }

    // --- Customers Collection ---
    match /customers/{customerId} {
      allow read, write: if isValidId(customerId);
    }

    // --- Suppliers Collection ---
    match /suppliers/{supplierId} {
      allow read, write: if isValidId(supplierId);
    }

    // --- Purchase Orders Collection ---
    match /purchase_orders/{poId} {
      allow read, write: if isValidId(poId);
    }

    // --- Stock Movements Collection ---
    match /stock_movements/{movementId} {
      allow read, write: if isValidId(movementId);
    }

    // --- Settings Collection ---
    match /settings/{settingId} {
      allow read, write: if isValidId(settingId);
    }

    // --- Staff Collection ---
    match /staff/{staffId} {
      allow read, write: if isValidId(staffId);
    }

    // --- Expenses Collection ---
    match /expenses/{expenseId} {
      allow read, write: if isValidId(expenseId);
    }

    // --- Audit Logs Collection ---
    match /audit_logs/{logId} {
      allow read, write: if isValidId(logId);
    }

    // --- Shifts Collection ---
    match /shifts/{shiftId} {
      allow read, write: if isValidId(shiftId);
    }

    // Fallback: Deny any undocumented top-level or sub-collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

